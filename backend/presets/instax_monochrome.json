{
  "name": "instax_monochrome",
  "label": "Instax monochrome",
  "description": "Instant-film Monochrome print: cropped to 3:4 portrait, black and white with gentle contrast, a slightly cool tone, grain and a soft vignette, on an off-white Instax Mini card with an optional handwritten caption.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "",
  "text_character_limit": 24,
  "steps": [
    {
      "filter": "crop_aspect",
      "on": "image",
      "ratio": [46, 62]
    },
    {
      "filter": "grayscale",
      "on": "image"
    },
    {
      "filter": "color_grade",
      "on": "image",
      "exposure": 0.05,
      "contrast": 0.2,
      "black_lift": 0.04,
      "white_rolloff": 0.4,
      "split": 0.15,
      "shadows": [90, 95, 105],
      "highlights": [250, 248, 242]
    },
    {
      "filter": "vignette",
      "on": "image",
      "amount": 0.2
    },
    {
      "filter": "paper_texture",
      "on": "image",
      "tint": 0,
      "stains": 0,
      "fade": 0,
      "grain": 0.06,
      "seed": 11
    },
    {
      "filter": "place_on_canvas",
      "on": "image",
      "margins": [0.087, 0.141, 0.087, 0.38],
      "fill": [250, 250, 247]
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$text",
      "color": [60, 60, 60],
      "align": "bottom",
      "font_style": "scribble",
      "font_size_ratio": 0.13,
      "margin_ratio": 0.095
    }
  ]
}
