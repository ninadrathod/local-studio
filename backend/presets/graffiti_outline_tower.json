{
  "name": "graffiti_outline_tower",
  "label": "Graffiti outline tower",
  "description": "Street graffiti: the user's text as one giant white outline word in tall poster capitals (always uppercase) running up the right edge of a darkened wall, with a white crown and arrow; the cut-out subject stands in front.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "HUSTLE",
  "text_character_limit": 16,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "color_grade",
      "on": "background",
      "exposure": -0.55,
      "saturation": 0.75,
      "contrast": 0.15
    },
    {
      "filter": "draw_shape",
      "on": "background",
      "as": "a_o",
      "shape": "circle",
      "x": 5,
      "y": 5,
      "size": 0.1,
      "clear": true
    },
    {
      "filter": "draw_text",
      "on": "a_o",
      "color": [255, 255, 255],
      "stroke_ratio": 0.004,
      "stroke_color": [255, 255, 255],
      "text": "$text",
      "font_style": "poster",
      "uppercase": true,
      "font_size_ratio": 0.24,
      "center_x": 0.86,
      "center_y": 0.5,
      "angle": -90,
      "max_width_ratio": 0.97
    },
    {
      "filter": "draw_shape",
      "on": "background",
      "as": "a_i",
      "shape": "circle",
      "x": 5,
      "y": 5,
      "size": 0.1,
      "clear": true
    },
    {
      "filter": "draw_text",
      "on": "a_i",
      "color": [255, 255, 255],
      "text": "$text",
      "font_style": "poster",
      "uppercase": true,
      "font_size_ratio": 0.24,
      "center_x": 0.86,
      "center_y": 0.5,
      "angle": -90,
      "max_width_ratio": 0.97
    },
    {
      "filter": "clip_to",
      "on": "a_o",
      "around": "a_i",
      "invert": true
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "a_o",
      "as": "background"
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "crown",
      "x": 0.14,
      "y": 0.12,
      "size": 0.13,
      "color": [255, 255, 255],
      "stroke": 0.009,
      "seed": 2
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "arrow",
      "x": 0.15,
      "y": 0.85,
      "size": 0.13,
      "color": [255, 255, 255],
      "stroke": 0.009,
      "seed": 4
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
}
