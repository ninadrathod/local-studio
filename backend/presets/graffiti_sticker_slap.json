{
  "name": "graffiti_sticker_slap",
  "label": "Graffiti sticker slap",
  "description": "Street graffiti: the user's text printed on two tilted street stickers — white on the right, yellow lower-left — slapped on a weathered wall with a white arrow, yellow crown and sparkles; the cut-out subject stands in front.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "KEEP IT REAL",
  "text_character_limit": 16,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "color_grade",
      "on": "background",
      "contrast": 0.15,
      "saturation": 0.9
    },
    {
      "filter": "paper_texture",
      "on": "background",
      "tint": 0,
      "stains": 0.2,
      "fade": 0,
      "grain": 0.04,
      "seed": 12
    },
    {
      "filter": "draw_text",
      "on": "background",
      "text": "$text",
      "font_style": "graffiti",
      "color": [15, 15, 15],
      "font_size_ratio": 0.06,
      "center_x": 0.8,
      "center_y": 0.42,
      "angle": -12,
      "max_width_ratio": 0.42,
      "box": "label",
      "box_fill": [250, 250, 245],
      "box_color": [250, 250, 245],
      "box_pad_ratio": 0.022,
      "box_radius_ratio": 0.015
    },
    {
      "filter": "draw_text",
      "on": "background",
      "text": "$text",
      "font_style": "graffiti",
      "color": [15, 15, 15],
      "font_size_ratio": 0.055,
      "center_x": 0.22,
      "center_y": 0.72,
      "angle": 9,
      "max_width_ratio": 0.42,
      "box": "label",
      "box_fill": [255, 214, 0],
      "box_color": [255, 214, 0],
      "box_pad_ratio": 0.022,
      "box_radius_ratio": 0.015
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "arrow",
      "x": 0.78,
      "y": 0.6,
      "size": 0.13,
      "color": [255, 255, 255],
      "stroke": 0.009,
      "seed": 4
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "crown",
      "x": 0.2,
      "y": 0.53,
      "size": 0.11,
      "color": [255, 214, 0],
      "stroke": 0.009,
      "seed": 3
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "stars",
      "x": 0.15,
      "y": 0.15,
      "size": 0.11,
      "color": [255, 255, 255],
      "stroke": 0.009,
      "seed": 6
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
}
