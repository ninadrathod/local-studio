{
  "name": "amber_teal_gel",
  "label": "Amber teal gel",
  "description": "Amber gel light on the subject (whites and highlights turn a light cream-amber, darks stay put) against a muted background pushed toward teal.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": false
    },
    {
      "filter": "color",
      "on": "background",
      "amount": 0.55
    },
    {
      "filter": "tone_curve",
      "on": "background",
      "red": [
        [
          0,
          0
        ],
        [
          128,
          104
        ],
        [
          255,
          200
        ]
      ],
      "green": [
        [
          0,
          10
        ],
        [
          128,
          140
        ],
        [
          255,
          236
        ]
      ],
      "blue": [
        [
          0,
          10
        ],
        [
          128,
          140
        ],
        [
          255,
          236
        ]
      ]
    },
    {
      "filter": "color_grade",
      "on": "background",
      "exposure": -0.15,
      "contrast": 0.05
    },
    {
      "filter": "tone_curve",
      "on": "subject",
      "red": [
        [
          0,
          18
        ],
        [
          128,
          142
        ],
        [
          255,
          255
        ]
      ],
      "green": [
        [
          0,
          3
        ],
        [
          128,
          130
        ],
        [
          255,
          222
        ]
      ],
      "blue": [
        [
          0,
          0
        ],
        [
          128,
          112
        ],
        [
          255,
          170
        ]
      ]
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
}
