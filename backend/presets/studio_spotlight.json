{
  "name": "studio_spotlight",
  "label": "Studio spotlight",
  "description": "HD pass, then a low-key studio portrait: subject cut out, background darkened, desaturated, softened and vignetted so the subject sits in a spotlight, then a gentle overall grade.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "ai_upscale",
      "on": "image",
      "long_edge": 1920,
      "denoise": 0.3
    },
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "color_grade",
      "on": "background",
      "exposure": -0.8,
      "contrast": 0.1,
      "saturation": 0.6
    },
    {
      "filter": "blur",
      "on": "background",
      "radius_ratio": 0.004,
      "exclude": "subject"
    },
    {
      "filter": "vignette",
      "on": "background",
      "amount": 0.55,
      "midpoint": 0.3,
      "roundness": 0.6
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    },
    {
      "filter": "color_grade",
      "on": "image",
      "contrast": 0.15,
      "white_rolloff": 0.4,
      "vibrance": 0.15
    },
    {
      "filter": "vignette",
      "on": "image",
      "amount": 0.2
    }
  ]
}
