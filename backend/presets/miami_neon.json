{
  "name": "miami_neon",
  "label": "Miami neon",
  "description": "HD pass, then a neon-dusk grade: purple shadows, hot-pink highlights, magenta tint and a pink bloom glow.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "ai_upscale",
      "on": "image",
      "long_edge": 1920,
      "denoise": 0.3
    },
    {
      "filter": "color_grade",
      "on": "image",
      "tint": 0.3,
      "exposure": -0.05,
      "contrast": 0.2,
      "black_lift": 0.03,
      "split": 0.7,
      "balance": 0.1,
      "shadows": [80, 40, 160],
      "highlights": [255, 120, 170],
      "saturation": 1.15,
      "vibrance": 0.2
    },
    {
      "filter": "bloom",
      "on": "image",
      "threshold": 0.6,
      "radius_ratio": 0.035,
      "amount": 0.45,
      "color": [255, 170, 220]
    }
  ]
}
