{
  "name": "neon_nights_script",
  "label": "Neon nights script",
  "description": "Night-darkened magenta background with a sunset split-tone; hot-pink neon brush-script title, tilted and glowing, behind the subject; cyan rim light on the subject.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "TITLE",
  "text_character_limit": 16,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "color_grade",
      "on": "background",
      "exposure": -0.6,
      "contrast": 0.25,
      "black_lift": 0.02,
      "tint": 0.2,
      "split": 0.5,
      "shadows": [
        60,
        20,
        120
      ],
      "highlights": [
        255,
        140,
        90
      ]
    },
    {
      "filter": "selective_color",
      "on": "background",
      "hue": "magenta",
      "width": 50,
      "saturation": 2.0,
      "lightness": 0.15,
      "others": 0.5,
      "pull": 0.5
    },
    {
      "filter": "draw_text",
      "on": "background",
      "text": "$text",
      "color": [
        255,
        215,
        240
      ],
      "align": "top",
      "font_size_ratio": 0.4,
      "margin_ratio": 0.04,
      "scale_y": 1.3,
      "stroke_color": [
        255,
        40,
        170
      ],
      "stroke_ratio": 0.005,
      "angle": -8,
      "glow_ratio": 0.025,
      "font_style": "signature"
    },
    {
      "filter": "glow_line_border",
      "on": "subject",
      "color": [
        0,
        220,
        255
      ],
      "width_ratio": 0.004,
      "blur_ratio": 0.006
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    },
    {
      "filter": "paper_texture",
      "on": "image",
      "tint": 0,
      "grain": 0.05,
      "stains": 0,
      "fade": 0
    }
  ]
}
