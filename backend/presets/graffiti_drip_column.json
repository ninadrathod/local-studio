{
  "name": "graffiti_drip_column",
  "label": "Graffiti drip column",
  "description": "Street graffiti: the user's text runs up the left edge as a dripping neon-green wet-paint piece with a pink 3-D shadow, on a darkened, muted wall with a white crown, arrow, stars and a pink bolt on the right; the cut-out subject stands in front.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "STAY REAL",
  "text_character_limit": 16,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "color_grade",
      "on": "background",
      "exposure": -0.7,
      "saturation": 0.45,
      "contrast": 0.2
    },
    {
      "filter": "draw_text",
      "on": "background",
      "text": "$text",
      "font_style": "wet_paint",
      "color": [255, 50, 160],
      "font_size_ratio": 0.15,
      "center_x": 0.122,
      "center_y": 0.5,
      "angle": 90,
      "max_width_ratio": 0.95,
      "stroke_ratio": 0.012,
      "stroke_color": [255, 50, 160]
    },
    {
      "filter": "draw_text",
      "on": "background",
      "text": "$text",
      "font_style": "wet_paint",
      "color": [60, 255, 120],
      "font_size_ratio": 0.15,
      "center_x": 0.11,
      "center_y": 0.5,
      "angle": 90,
      "max_width_ratio": 0.95,
      "stroke_ratio": 0.012,
      "stroke_color": [15, 15, 15]
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "bolt",
      "x": 0.3,
      "y": 0.1,
      "size": 0.13,
      "color": [255, 50, 160],
      "stroke": 0.009,
      "seed": 5
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "crown",
      "x": 0.86,
      "y": 0.1,
      "size": 0.14,
      "color": [255, 255, 255],
      "stroke": 0.009,
      "seed": 3
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "arrow",
      "x": 0.84,
      "y": 0.47,
      "size": 0.14,
      "color": [255, 255, 255],
      "stroke": 0.009,
      "seed": 4
    },
    {
      "filter": "doodle",
      "on": "background",
      "style": "stars",
      "x": 0.86,
      "y": 0.9,
      "size": 0.12,
      "color": [255, 255, 255],
      "stroke": 0.009,
      "seed": 6
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
}
