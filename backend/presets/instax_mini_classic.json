{
  "name": "instax_mini_classic",
  "label": "Instax mini classic",
  "description": "Instant-film Mini print: cropped to 3:4 portrait, bright soft grade with lifted blacks, slightly cool shadows and creamy highlights, light glow and grain, on an off-white Instax Mini card with an optional handwritten caption in the bottom band.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "",
  "text_character_limit": 24,
  "steps": [
    {
      "filter": "crop_aspect",
      "on": "image",
      "ratio": [46, 62]
    },
    {
      "filter": "color_grade",
      "on": "image",
      "temperature": -0.05,
      "exposure": 0.15,
      "contrast": -0.1,
      "black_lift": 0.06,
      "white_rolloff": 0.5,
      "split": 0.3,
      "shadows": [60, 90, 120],
      "highlights": [255, 245, 230],
      "saturation": 0.92
    },
    {
      "filter": "bloom",
      "on": "image",
      "threshold": 0.75,
      "radius_ratio": 0.02,
      "amount": 0.2
    },
    {
      "filter": "vignette",
      "on": "image",
      "amount": 0.15
    },
    {
      "filter": "paper_texture",
      "on": "image",
      "tint": 0,
      "stains": 0,
      "fade": 0,
      "grain": 0.04,
      "seed": 11
    },
    {
      "filter": "place_on_canvas",
      "on": "image",
      "margins": [0.087, 0.141, 0.087, 0.38],
      "fill": [250, 250, 247]
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$text",
      "color": [60, 60, 60],
      "align": "bottom",
      "font_style": "scribble",
      "font_size_ratio": 0.13,
      "margin_ratio": 0.095
    }
  ]
}
