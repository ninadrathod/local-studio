{
  "name": "bw_bg_glowing_subject",
  "label": "B&W background with glowing subject",
  "description": "Extract subject, make the background grayscale, draw a glowing line border around the subject (color input), then place it on top.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "grayscale",
      "on": "background"
    },
    {
      "filter": "glow_line_border",
      "on": "subject",
      "color": [0, 255, 200],
      "width_ratio": 0.007,
      "blur_ratio": 0.0028
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
}
