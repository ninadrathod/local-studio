{
  "name": "instax_square_sunny",
  "label": "Instax square sunny",
  "description": "Instant-film Square print: cropped to 1:1, warm overexposed summer grade with golden highlights, peachy shadows and a soft glow, on an off-white Instax Square card with an optional handwritten caption.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "",
  "text_character_limit": 24,
  "steps": [
    {
      "filter": "crop_aspect",
      "on": "image",
      "ratio": [1, 1]
    },
    {
      "filter": "color_grade",
      "on": "image",
      "temperature": 0.3,
      "exposure": 0.3,
      "contrast": -0.05,
      "black_lift": 0.05,
      "white_rolloff": 0.6,
      "split": 0.35,
      "shadows": [110, 80, 70],
      "highlights": [255, 230, 190],
      "saturation": 1.05,
      "vibrance": 0.2
    },
    {
      "filter": "bloom",
      "on": "image",
      "threshold": 0.6,
      "radius_ratio": 0.03,
      "amount": 0.35,
      "color": [255, 230, 200]
    },
    {
      "filter": "vignette",
      "on": "image",
      "amount": 0.1
    },
    {
      "filter": "paper_texture",
      "on": "image",
      "tint": 0,
      "stains": 0,
      "fade": 0,
      "grain": 0.04,
      "seed": 11
    },
    {
      "filter": "place_on_canvas",
      "on": "image",
      "margins": [0.081, 0.097, 0.081, 0.29],
      "fill": [250, 250, 247]
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$text",
      "color": [60, 60, 60],
      "align": "bottom",
      "font_style": "scribble",
      "font_size_ratio": 0.097,
      "margin_ratio": 0.071
    }
  ]
}
