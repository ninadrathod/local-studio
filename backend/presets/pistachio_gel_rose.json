{
  "name": "pistachio_gel_rose",
  "label": "Pistachio gel rose",
  "description": "Mint gel light on the subject (whites turn a light pistachio green) against a muted background pushed toward rose pink.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
