      "as": "subject",
      "bg_as": "background",
      "single_subject": false
    },
    {
      "filter": "color",
      "on": "background",
      "amount": 0.55
    },
    {
      "filter": "tone_curve",
      "on": "background",
      "red": [
        [
          0,
          10
        ],
        [
          128,
          163
        ],
        [
          255,
          255
        ]
      ],
      "green": [
        [
          0,
          0
        ],
        [
          128,
          103
        ],
        [
          255,
          195
        ]
      ],
      "blue": [
        [
          0,
          0
        ],
        [
          128,
          118
        ],
        [
          255,
          210
        ]
      ]
    },
    {
      "filter": "color_grade",
      "on": "background",
      "exposure": -0.15,
      "contrast": 0.05
    },
    {
      "filter": "tone_curve",
      "on": "subject",
      "red": [
        [
          0,
          0
        ],
        [
          128,
          116
        ],
        [
          255,
          185
        ]
      ],
      "green": [
        [
          0,
          16
        ],
        [
          128,
          141
        ],
        [
          255,
          255
        ]
      ],
      "blue": [
        [
          0,
          0
        ],
        [
          128,
          127
        ],
        [
          255,
          215
        ]
      ]
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
