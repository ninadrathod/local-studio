{
  "name": "sky_gel_amber",
  "label": "Sky gel amber",
  "description": "Blue gel light on the subject (whites turn a light sky blue) against a muted background pushed toward golden amber - the reverse of red gel.",
  "ar": "non-square",
  "text_input": "no",
