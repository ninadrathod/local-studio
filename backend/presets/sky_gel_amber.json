      "blue": [
        [
          0,
          16
        ],
        [
          128,
          141
        ],
        [
          255,
          255
        ]
      ]
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
