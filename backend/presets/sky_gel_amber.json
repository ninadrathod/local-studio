          9
        ],
        [
          128,
          135
        ],
        [
          255,
          225
        ]
      ],
      "blue": [
        [
          0,
          0
        ],
        [
          128,
          85
        ],
        [
          255,
          175
        ]
      ]
    },
    {
      "filter": "color_grade",
      "on": "background",
      "exposure": -0.15,
      "contrast": 0.05
    },
    {
      "filter": "tone_curve",
      "on": "subject",
      "red": [
        [
          0,
          0
        ],
        [
          128,
          118
        ],
        [
          255,
          190
        ]
      ],
      "green": [
        [
