      "on": "background",
      "amount": 0.55
    },
    {
      "filter": "tone_curve",
      "on": "background",
      "red": [
        [
          0,
          10
        ],
        [
          128,
          165
        ],
        [
          255,
          255
        ]
      ],
      "green": [
        [
