{
  "name": "polaroid_memory",
  "label": "Polaroid memory",
  "description": "Soft warm film grade, date/time stamp on the photo, classic white polaroid mat (1.4×), and a flow-script caption in the bottom band.",
  "ar": "square",
  "text_input": "yes",
  "default_text": "instant memory",
  "text_character_limit": 24,
  "steps": [
    {
      "filter": "contrast",
      "on": "image",
      "amount": 1.08
    },
    {
      "filter": "color",
      "on": "image",
      "amount": 0.92
    },
    {
      "filter": "overlay",
      "on": "image",
      "color": [255, 236, 210],
      "alpha": 0.12
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$datetime",
      "color": [255, 255, 255],
      "align": "top_right",
      "font_style": "sans",
      "stroke_color": [40, 40, 40],
      "font_size_ratio": 0.0306,
      "stroke_ratio": 0.0014,
      "margin_ratio": 0.0194
    },
    {
      "filter": "place_on_canvas",
      "on": "image",
      "scale": 1.4,
      "fill": [255, 255, 255],
      "layout": "polaroid",
      "as": "image"
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$text",
      "color": [55, 55, 55],
      "align": "bottom",
      "font_style": "flow",
      "font_size_ratio": 0.0417,
      "margin_ratio": 0.0278
    }
  ]
}
