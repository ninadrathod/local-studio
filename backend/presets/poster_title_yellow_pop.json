{
  "name": "poster_title_yellow_pop",
  "label": "Poster title: yellow pop",
  "description": "Subject cut out; background yellows boosted while other colours mute; tall red poster title behind the subject.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "TITLE",
  "text_character_limit": 16,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "selective_color",
      "on": "background",
      "hue": "yellow",
      "width": 45,
      "saturation": 1.8,
      "lightness": 0.12,
      "others": 0.35,
      "pull": 0.4
    },
    {
      "filter": "draw_text",
      "on": "background",
      "text": "$text",
      "color": [
        220,
        30,
        30
      ],
      "align": "top",
      "font_size_ratio": 0.34,
      "scale_y": 1.9,
      "margin_ratio": 0.03,
      "font_style": "poster"
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
}
