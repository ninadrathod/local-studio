{
  "name": "film_dust",
  "label": "Film dust",
  "description": "Faded warm film grade with matte blacks, grain, scanned-film dust specks, hairs and faint scratches, and a light vignette.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "color_grade",
      "on": "image",
      "temperature": 0.2,
      "contrast": -0.1,
      "black_lift": 0.1,
      "white_rolloff": 0.5,
      "split": 0.3,
      "shadows": [60, 70, 80],
      "highlights": [255, 225, 180],
      "saturation": 0.8
    },
    {
      "filter": "paper_texture",
      "on": "image",
      "tint": 0,
      "stains": 0,
      "fade": 0,
      "grain": 0.07,
      "seed": 7
    },
    {
      "filter": "film_dust",
      "on": "image",
      "amount": 0.5,
      "hairs": 3,
      "scratches": 2
    },
    {
      "filter": "vignette",
      "on": "image",
      "amount": 0.2
    }
  ]
}
