{
  "name": "word_wall_poster",
  "label": "Word wall poster",
  "description": "Typographic poster: the background becomes a wall of the user's text repeated in mixed sizes in black, coral and grey on cream, with a yellow sun circle behind the subject's head and a white sticker outline on the subject.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "GOOD VIBES",
  "text_character_limit": 16,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "text_pattern",
      "on": "image",
      "as": "background",
      "text": "$text",
      "separator": " • ",
      "uppercase": true,
      "font_style": "bold_display",
      "sizes": [0.09, 0.05, 0.07, 0.04],
      "gap_ratio": 0.01,
      "colors": [
        [30, 30, 30],
        [235, 80, 60],
        [30, 30, 30],
        [120, 120, 120]
      ],
      "background": [245, 238, 225]
    },
    {
      "filter": "draw_shape",
      "on": "background",
      "shape": "circle",
      "x": 0.5,
      "y": 0.36,
      "size": 0.6,
      "color": [255, 200, 40]
    },
    {
      "filter": "sticker_outline",
      "on": "subject",
      "color": [255, 255, 255],
      "width_ratio": 0.008
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    }
  ]
}
