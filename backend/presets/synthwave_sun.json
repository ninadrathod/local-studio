{
  "name": "synthwave_sun",
  "label": "Synthwave sun",
  "description": "Retro synthwave poster: the background turns deep night purple with a big glowing coral sun disc behind the cut-out subject, and the user's text glows in neon tube lettering along the bottom.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "MIDNIGHT",
  "text_character_limit": 14,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "color_grade",
      "on": "background",
      "temperature": -0.3,
      "tint": 0.45,
      "exposure": -1.3,
      "contrast": 0.25,
      "split": 0.75,
      "shadows": [40, 10, 90],
      "highlights": [255, 80, 200],
      "saturation": 1.15
    },
    {
      "filter": "draw_shape",
      "on": "background",
      "shape": "circle",
      "x": 0.5,
      "y": 0.42,
      "size": 0.62,
      "color": [255, 96, 128]
    },
    {
      "filter": "bloom",
      "on": "background",
      "threshold": 0.45,
      "radius_ratio": 0.04,
      "amount": 0.6,
      "color": [255, 120, 170]
    },
    {
      "filter": "composite",
      "base": "background",
      "overlay": "subject",
      "as": "image"
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$text",
      "color": [210, 255, 255],
      "align": "bottom",
      "font_style": "neon_lines",
      "font_size_ratio": 0.11,
      "margin_ratio": 0.05,
      "glow_ratio": 0.03,
      "glow_color": [255, 60, 200]
    }
  ]
}
