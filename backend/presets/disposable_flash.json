{
  "name": "disposable_flash",
  "label": "Disposable flash",
  "description": "90s disposable-camera look: harsh flash contrast, green-tinted shadows, flash falloff vignette, grain, and an orange date stamp in the corner.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "color_grade",
      "on": "image",
      "temperature": 0.1,
      "tint": -0.1,
      "exposure": 0.1,
      "contrast": 0.35,
      "split": 0.3,
      "shadows": [30, 70, 50],
      "highlights": [255, 240, 215],
      "saturation": 1.1
    },
    {
      "filter": "vignette",
      "on": "image",
      "amount": 0.35,
      "midpoint": 0.4
    },
    {
      "filter": "paper_texture",
      "on": "image",
      "tint": 0,
      "stains": 0,
      "fade": 0,
      "grain": 0.07,
      "seed": 7
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$date",
      "color": [255, 140, 40],
      "align": "bottom_right",
      "font_size_ratio": 0.04,
      "margin_ratio": 0.04,
      "font_style": "stamp"
    }
  ]
}
