{
  "name": "emerald_moody",
  "label": "Emerald moody",
  "description": "HD pass, then a dark, cinematic green grade: deep emerald shadows, warm muted highlights, lowered exposure, punchy contrast, and a vignette.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "ai_upscale",
      "on": "image",
      "long_edge": 1920,
      "denoise": 0.3
    },
    {
      "filter": "color_grade",
      "on": "image",
      "temperature": -0.05,
      "tint": -0.3,
      "exposure": -0.15,
      "contrast": 0.3,
      "black_lift": 0.04,
      "shadows": [0, 90, 60],
      "highlights": [235, 215, 160],
      "split": 0.65,
      "balance": -0.2,
      "saturation": 0.85,
      "vibrance": 0.1
    },
    {
      "filter": "vignette",
      "on": "image",
      "amount": 0.35
    }
  ]
}
