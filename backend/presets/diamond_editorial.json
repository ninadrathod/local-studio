{
  "name": "diamond_editorial",
  "label": "Diamond editorial",
  "description": "Editorial cover: sand-coloured backdrop with a large diamond window onto the photo, an offset outline diamond, the cut-out subject on top, and the user's text as a tall bold title running up the left edge.",
  "ar": "non-square",
  "text_input": "yes",
  "default_text": "EDITION",
  "text_character_limit": 14,
  "steps": [
    {
      "filter": "extract_subject",
      "on": "image",
      "as": "subject",
      "bg_as": "background",
      "single_subject": true
    },
    {
      "filter": "overlay",
      "on": "image",
      "as": "canvas",
      "color": [214, 196, 176],
      "alpha": 1.0
    },
    {
      "filter": "draw_shape",
      "on": "image",
      "as": "diamond",
      "shape": "diamond",
      "x": 0.56,
      "y": 0.5,
      "size": 0.95,
      "clear": true
    },
    {
      "filter": "clip_to",
      "on": "image",
      "as": "window",
      "around": "diamond"
    },
    {
      "filter": "composite",
      "base": "canvas",
      "overlay": "window",
      "as": "image"
    },
    {
      "filter": "draw_shape",
      "on": "image",
      "shape": "diamond",
      "x": 0.6,
      "y": 0.54,
      "size": 0.95,
      "fill": false,
      "stroke_ratio": 0.004,
      "stroke_color": [40, 35, 30]
    },
    {
      "filter": "composite",
      "base": "image",
      "overlay": "subject",
      "as": "image"
    },
    {
      "filter": "draw_text",
      "on": "image",
      "text": "$text",
      "color": [40, 35, 30],
      "font_style": "poster",
      "font_size_ratio": 0.13,
      "angle": 90,
      "center_x": 0.085,
      "center_y": 0.5,
      "max_width_ratio": 0.9
    }
  ]
}
