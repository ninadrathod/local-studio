{
  "name": "mocha_moody",
  "label": "Mocha moody",
  "description": "HD pass, then brown, matte moody edit: faded blacks, pulled whites, warm-brown curves, muted colour, deep highlight recovery.",
  "ar": "non-square",
  "text_input": "no",
  "default_text": "",
  "text_character_limit": 0,
  "steps": [
    {
      "filter": "ai_upscale",
      "on": "image",
      "long_edge": 1920,
      "denoise": 0.3
    },
    {
      "filter": "shadows_highlights",
      "on": "image",
      "shadows": 0.3,
      "highlights": -0.65
    },
    {
      "filter": "tone_curve",
      "on": "image",
      "master": [
        [
          0,
          38
        ],
        [
          70,
          72
        ],
        [
          180,
          176
        ],
        [
          255,
          226
        ]
      ],
      "red": [
        [
          0,
          10
        ],
        [
          128,
          138
        ],
        [
          255,
          248
        ]
      ],
      "green": [
        [
          0,
          2
        ],
        [
          128,
          120
        ],
        [
          255,
          232
        ]
      ],
      "blue": [
        [
          0,
          0
        ],
        [
          128,
          100
        ],
        [
          255,
          196
        ]
      ]
    },
    {
      "filter": "color_grade",
      "on": "image",
      "saturation": 0.62,
      "temperature": 0.1
    }
  ]
}
