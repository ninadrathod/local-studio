# Copy to .env (gitignored) and set the values: cp .env.example .env
# scripts/run.sh loads .env on every start (so update.sh and cron restarts use it too).

# 1 = lightweight mode for low-RAM machines (e.g. a 1 GB Raspberry Pi): every input
#     image is downscaled to <= 2 megapixels, the HD upscale uses a plain resize instead of the AI model, and the
#     subject cutout uses the small u2netp model. 0 = full quality.
LIGHTWEIGHT=0
