# Copy to .env (gitignored) and set the values: cp .env.example .env
# docker compose reads it on every `up`: LIGHTWEIGHT for the backend, FRONTEND_PORT for
# the port the app is served on.

# 1 = lightweight mode for low-RAM machines: every input
#     image is downscaled to <= 2 megapixels, the HD upscale uses a plain resize instead of the AI model, and the
#     subject cutout uses the small u2netp model. 0 = full quality.
LIGHTWEIGHT=0

# Port the app is served on (http://localhost:<port>). Default 5500.
# FRONTEND_PORT=5500
