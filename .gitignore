.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.env
.venv/
venv/
*.egg-info/
dist/
build/
node_modules/
.idea/
.vscode/

# create-preset comparison pages (POC / fonts / gallery) — never ship
previews/_candidates/

# rembg / ONNX model weights — download via setup, never commit
.rembg/
**/*.onnx
backend/helpers/models/

# Live preset DB if prepare_db.py is ever run outside Docker (Docker keeps it on the
# studio-data volume). backend/database/presets.db stays committed but frozen: it seeds
# the counts the first time a database is created.
backend/database/presets.local.db
backend/database/presets.local.db-journal

# numba / runtime junk
*.ses
:memory:.ses
