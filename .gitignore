.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.env
.venv/
venv/
*.egg-info/
dist/
build/
node_modules/
.idea/
.vscode/

# create-preset comparison pages (POC / fonts / gallery) — never ship
previews/_candidates/

# rembg / ONNX model weights — download via setup, never commit
.rembg/
**/*.onnx
backend/helpers/models/

# run.sh server logs
logs/

# Local preset DB (created/seeded by setup.sh and run.sh; holds per-install popular counts).
# backend/database/presets.db stays committed but frozen (legacy seed for old clones).
backend/database/presets.local.db
backend/database/presets.local.db-journal

# numba / runtime junk
*.ses
:memory:.ses
